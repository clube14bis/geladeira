{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && ((!data.exists() && newData.hasChildren(['username', 'fullName', 'phone', 'cpf', 'email', 'createdAt'])) || (data.exists() && newData.hasChildren(['username', 'fullName', 'phone', 'cpf', 'email', 'createdAt']) && newData.child('username').val() === data.child('username').val() && newData.child('fullName').val() === data.child('fullName').val() && newData.child('phone').val() === data.child('phone').val() && newData.child('cpf').val() === data.child('cpf').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",
        "username": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9._-]{3,24}$/)" },
        "fullName": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 80" },
        "phone": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{10,11}$/)" },
        "cpf": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{11}$/)" },
        "email": { ".validate": "newData.isString() && newData.val().matches(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/) && newData.val().length <= 120" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },
    "orders": {
      ".indexOn": ["status"],
      ".read": "auth != null && auth.uid === 'rS8DvYaBHnfPcueDePKr02SFTLE2'",
      "$orderId": {
        ".read": "auth != null && (auth.uid === 'kQ1XjyUTg7h7AtTX222UV9wVOY03' || data.child('uid').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === 'kQ1XjyUTg7h7AtTX222UV9wVOY03' || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('username').val() === root.child('users').child(auth.uid).child('username').val() && newData.child('fullName').val() === root.child('users').child(auth.uid).child('fullName').val() && newData.child('status').val() === 'pending'))",
        ".validate": "newData.hasChildren(['uid', 'username', 'fullName', 'items', 'totalItems', 'totalCents', 'status', 'createdAt']) && newData.child('items').hasChildren()",
        "uid": { ".validate": "newData.isString() && newData.val().length > 0" },
        "username": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "fullName": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "items": {
          "$itemId": {
            ".validate": "$itemId.matches(/^[A-Za-z0-9_-]+$/) && newData.hasChildren(['id', 'drink', 'quantity', 'priceCents', 'subtotalCents'])",
            "id": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]+$/)" },
            "drink": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "quantity": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
            "priceCents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "subtotalCents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "$other": { ".validate": false }
          }
        },
        "totalItems": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
        "totalCents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'processing' || newData.val() === 'log_failed'" },
        "unlockAt": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "execution": {
          ".write": "auth != null && auth.uid === 'rS8DvYaBHnfPcueDePKr02SFTLE2' && data.parent().exists()",
          ".validate": "newData.hasChildren(['state', 'updatedAt'])",
          "state": { ".validate": "newData.val() === 'opened' || newData.val() === 'locked'" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "userOrders": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$orderId": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('uid').val() === auth.uid",
          ".validate": "newData.hasChildren(['uid', 'items', 'totalCents', 'createdAt']) && newData.child('items').hasChildren()",
          "uid": { ".validate": "newData.val() === auth.uid" },
          "items": {
            "$itemId": {
              ".validate": "$itemId.matches(/^[A-Za-z0-9_-]+$/) && newData.hasChildren(['id', 'drink', 'quantity', 'priceCents', 'subtotalCents'])",
              "id": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]+$/)" },
              "drink": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
              "quantity": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
              "priceCents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "subtotalCents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "$other": { ".validate": false }
            }
          },
          "totalCents": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "$other": { ".validate": false }
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === 'IxZWx1TMk8VsTdEdCVUltFd96a93' && newData.val() === true"
      }
    },
    "catalog": {
      ".read": "auth != null",
      "$productId": {
        ".write": "auth != null && (auth.uid === 'IxZWx1TMk8VsTdEdCVUltFd96a93' || root.child('admins').child(auth.uid).val() === true)",
        "stock": {
          ".write": "auth != null && newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() === 0) || (data.exists() && newData.val() <= data.val()))",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        }
      }
    }
  }
}
