{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.hasChildren(['username', 'fullName', 'phone', 'cpf', 'createdAt'])",
        "username": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9._-]{3,24}$/)" },
        "fullName": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 80" },
        "phone": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{10,11}$/)" },
        "cpf": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{11}$/)" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    },
    "orders": {
      ".indexOn": ["status"],
      "$orderId": {
        ".read": "auth != null && (auth.uid === 'kQ1XjyUTg7h7AtTX222UV9wVOY03' || data.child('uid').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === 'kQ1XjyUTg7h7AtTX222UV9wVOY03' || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('username').val() === root.child('users').child(auth.uid).child('username').val() && newData.child('fullName').val() === root.child('users').child(auth.uid).child('fullName').val() && newData.child('status').val() === 'pending'))",
        ".validate": "newData.hasChildren(['uid', 'username', 'fullName', 'items', 'totalItems', 'status', 'createdAt']) && newData.child('items').hasChildren()",
        "uid": { ".validate": "newData.isString() && newData.val().length > 0" },
        "username": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "fullName": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "items": {
          "$itemId": {
            ".validate": "$itemId.matches(/^[0-9]+$/) && newData.hasChildren(['drink', 'quantity'])",
            "drink": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "quantity": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
            "$other": { ".validate": false }
          }
        },
        "totalItems": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
        "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'processing' || newData.val() === 'log_failed'" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    }
  }
}
